# Copy to keeper/.env only when running the keeper standalone.
# Local repository runs can reuse ../contracts/.env instead.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=0xYOUR_TESTNET_ONLY_KEEPER_PRIVATE_KEY
MARKET_ADDRESS=0xDEPLOYED_MARKET_ADDRESS
SUPRA_ORACLE_ADDRESS=0xDEPLOYED_SUPRA_ORACLE_ADDRESS

# Supra Pull testnet proofs are public; no API key is required.
SUPRA_PROOF_URL=https://rpc-testnet-dora-2.supra.com

KEEPER_POLL_MILLISECONDS=1000
LIVE_UPDATE_INTERVAL_SECONDS=20
TRANSACTION_TIMEOUT_SECONDS=45
RUST_LOG=schmeckles_keeper=info
