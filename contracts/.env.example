# Copy this file to contracts/.env. Never commit contracts/.env.
# Use a dedicated testnet-only wallet. The same key initially acts as owner and keeper.
PRIVATE_KEY=0xYOUR_MONAD_TESTNET_DEPLOYER_OR_KEEPER_PRIVATE_KEY
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Supra Pull's testnet REST endpoint is public; no oracle API key is required.
SUPRA_PROOF_URL=https://rpc-testnet-dora-2.supra.com

# Fill these from deployment output. They are safe to publish; PRIVATE_KEY is not.
MUSDC_ADDRESS=0xDEPLOYED_MUSDC_ADDRESS
SUPRA_ORACLE_ADDRESS=0xDEPLOYED_SUPRA_ORACLE_ADDRESS
MARKET_ADDRESS=0xDEPLOYED_MARKET_ADDRESS

KEEPER_POLL_MILLISECONDS=1000
LIVE_UPDATE_INTERVAL_SECONDS=20
TRANSACTION_TIMEOUT_SECONDS=45
